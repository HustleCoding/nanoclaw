# NanoClaw — environment configuration
# Copy to .env and fill in. `bash nanoclaw.sh` reads this; secrets for the agent
# are stored in the OneCLI vault (see docs/indie-ops-deploy.md), NOT here.

# ─── Telegram channel (.claude/skills/add-telegram) ──────────────────────
# Bot token from @BotFather. Group Privacy should be OFF for group chats.
TELEGRAM_BOT_TOKEN=

# ─── OpenCode agent provider (.claude/skills/add-opencode) ───────────────
# Selects the OpenCode backend. This install is configured for OpenCode Zen.
# These are read on the host and passed into the container only for groups whose
# provider is `opencode`. They do NOT switch the provider by themselves — set the
# group's provider with `ncl groups config update --provider opencode` (the
# deploy-indie-ops.sh helper does this for you).
#
# NOTE: put comments on their own lines — a `#` inside a value is kept verbatim
# and will break the model id.

# OpenCode Zen (opencode.ai subscription). `OPENCODE_PROVIDER=opencode` here is
# OpenCode's *Zen provider id*, distinct from NanoClaw's AGENT_PROVIDER=opencode.
OPENCODE_PROVIDER=opencode
# Use a real Zen model id from https://opencode.ai/docs/zen/
OPENCODE_MODEL=opencode/big-pickle
OPENCODE_SMALL_MODEL=opencode/big-pickle
ANTHROPIC_BASE_URL=https://opencode.ai/zen/v1

# The Zen API key itself is NOT set here — register it in the OneCLI vault with an
# x-api-key header (see docs/indie-ops-deploy.md), so it never lives in .env or
# the container environment.
